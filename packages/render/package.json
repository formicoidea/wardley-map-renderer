{
  "name": "@wardleyapi/render",
  "version": "0.1.0",
  "description": "Wardley Map render pipeline — SVG/PNG generation from WardleyMap JSON",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "bundle:interactive": "tsx scripts/bundle-interactive.ts",
    "prebuild": "tsx scripts/bundle-interactive.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@asteasolutions/zod-to-openapi": "^8.4.3",
    "openapi3-ts": "^4.5.0",
    "@hono/node-server": "^1.19.11",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.12.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
