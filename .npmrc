# GitHub Packages registry for the @formicoidea scope.
# Public deps (zod, @resvg/resvg-js, …) still resolve from the default npm registry —
# only @formicoidea/* is routed here.
@formicoidea:registry=https://npm.pkg.github.com

# Auth is read from an environment variable — NEVER hardcode a token here.
# CI: actions/setup-node injects NODE_AUTH_TOKEN (= secrets.GITHUB_TOKEN).
# Local publish/install: export NODE_AUTH_TOKEN with a PAT that has read:packages
# (or write:packages to publish).
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
