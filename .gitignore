# ── Dependencies ──────────────────────────────
node_modules/

# ── Build output ──────────────────────────────
dist/
*.tsbuildinfo

# ── Turborepo ────────────────────────────────
.turbo/

# ── Environment & secrets ─────────────────────
.env
.env.local
.env.*.local

# ── Package manager ───────────────────────────
# pnpm is the project's package manager; ignore npm/yarn lockfiles
package-lock.json
yarn.lock

# ── IDE / Editor ──────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── OS files ──────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Claude Code ───────────────────────────────
.claude/
.omc/

# ── Logs & debug ──────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ── Test & coverage ───────────────────────────
coverage/
.nyc_output/

# ── Temporary files ───────────────────────────
tmp/
tmp/renders/
*.tmp

# Exclude large output files
evaluations/*.html
evaluations/*.json

# But keep summary reports
!evaluations/summary-*.csv

# ── Internal docs / agent instructions (non-public) ──
/docs/
CLAUDE.md

# ── Generated schema (regenerated at publish, see prepublishOnly) ──
/schema/

# ── scripts/ : dev utilities ignored, keep only build-critical ones ──
/scripts/**
!/scripts/bundle-interactive.ts
!/scripts/generate-json-schema.ts

# ── data/ : ignore all except fixtures used by visual-regression.test.ts ──
/data/**
!/data/mapkeep/
!/data/mapkeep/mapkeep-extracted-maps.json
!/data/verified-exemples/
!/data/verified-exemples/**